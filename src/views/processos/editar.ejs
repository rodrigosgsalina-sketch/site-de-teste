<%- include('../partials/cabecalho', { titulo: titulo }) %>

<div class="cartao">
  <% if (erro) { %><div class="aviso aviso-erro"><%= erro %></div><% } %>

  <form method="post" action="/processos/<%= processo.id %>/editar">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <fieldset>
      <legend>Processo</legend>
      <div class="linha-campos">
        <div class="campo">
          <label>Número</label>
          <input type="text" value="<%= processo.codigo %>" disabled>
        </div>
        <div class="campo">
          <label>Tipo</label>
          <input type="text" value="<%= processo.tipo_processo %>" disabled>
          <div class="dica">O tipo define o checklist e não pode ser alterado após a abertura.</div>
        </div>
        <%# Os subtipos são detalhamento e podem mudar depois. O checklist
            acompanha: entra o que passou a valer, sai o que deixou — e o que
            já foi respondido fica onde está. %>
        <% if (subtiposDoTipo.length) { %>
          <div class="campo largo">
            <label>Subtipos</label>
            <div class="subtipos-lista">
              <% subtiposDoTipo.forEach(function (sub) { %>
                <label class="subtipo-opcao">
                  <input type="checkbox" name="subtipo_processo_id" value="<%= sub.id %>"
                         <%= subtiposDoProcesso.some(function (x) { return x.id === sub.id; }) ? 'checked' : '' %>>
                  <span><%= sub.nome %></span>
                </label>
              <% }) %>
            </div>
            <div class="dica">
              Marcar ou desmarcar acerta o checklist deste processo. Itens que já receberam resposta
              não são removidos — eles continuam listados.
            </div>
          </div>
        <% } %>
        <div class="campo">
          <label for="data_previsao">Previsão de conclusão</label>
          <input type="date" id="data_previsao" name="data_previsao" value="<%= processo.data_previsao || '' %>">
        </div>
        <div class="campo">
          <label for="responsavel_interno_id">Responsável interno</label>
          <select id="responsavel_interno_id" name="responsavel_interno_id">
            <option value="">—</option>
            <% responsaveis.forEach(function (u) { %>
              <option value="<%= u.id %>" <%= String(processo.responsavel_interno_id) === String(u.id) ? 'selected' : '' %>><%= u.nome %> (<%= u.setor %>)</option>
            <% }) %>
          </select>
        </div>
      </div>
    </fieldset>

    <%- include('../partials/seletor-cliente', { totalClientes: totalClientes, clienteAtual: clienteAtual, selecionado: processo.cliente_id }) %>

    <% if (!processo.cliente_id) { %>
      <div class="aviso aviso-alerta">
        Este processo foi aberto antes do seletor de clientes e ainda guarda a empresa
        <strong><%= processo.razao_social %></strong> como texto. Escolha o cliente correspondente
        para ligá-lo ao cadastro — os dados da empresa serão atualizados a partir da ficha.
      </div>
    <% } %>

    <fieldset>
      <legend>Complemento</legend>
      <div class="campo">
        <label for="etapa_atual">Etapa atual</label>
        <input type="text" id="etapa_atual" name="etapa_atual" value="<%= processo.etapa_atual || '' %>">
      </div>
      <div class="campo">
        <label for="observacoes">Observações</label>
        <textarea id="observacoes" name="observacoes"><%= processo.observacoes || '' %></textarea>
      </div>
    </fieldset>

    <div class="acoes">
      <button class="botao">Salvar alterações</button>
      <a class="botao botao-secundario" href="/processos/<%= processo.id %>">Voltar</a>
    </div>
  </form>
</div>

<%- include('../partials/rodape') %>
