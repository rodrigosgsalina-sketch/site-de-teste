<%- include('../partials/cabecalho', { titulo: titulo }) %>

<div class="cartao">
  <div class="aviso aviso-info">
    Ao salvar, o sistema gera o número do processo automaticamente (PARAMETROS → Numeração),
    define o status <strong>Aberto</strong>, calcula a previsão de conclusão somando
    <strong><%= prazoPadrao %> dia(s)</strong> à data de abertura e clona do
    <strong>CHECKLIST_MODELO</strong> todos os itens do tipo escolhido mais os itens aplicáveis a todos os processos.
  </div>

  <% if (erro) { %><div class="aviso aviso-erro"><%= erro %></div><% } %>

  <form method="post" action="/processos">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <fieldset>
      <legend>Processo</legend>
      <div class="linha-campos">
        <div class="campo">
          <label for="tipo_processo_id">Tipo de processo <span class="obrig">*</span></label>
          <select id="tipo_processo_id" name="tipo_processo_id" required>
            <option value="">Selecione…</option>
            <% tipos.forEach(function (t) { %>
              <option value="<%= t.id %>" <%= String(valores.tipo_processo_id) === String(t.id) ? 'selected' : '' %>><%= t.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="campo">
          <label for="data_abertura">Data de abertura</label>
          <input type="date" id="data_abertura" name="data_abertura" value="<%= valores.data_abertura || '' %>">
        </div>
        <div class="campo">
          <label for="data_previsao">Previsão de conclusão</label>
          <input type="date" id="data_previsao" name="data_previsao" value="<%= valores.data_previsao || '' %>">
          <div class="dica">Deixe em branco para calcular automaticamente.</div>
        </div>
        <div class="campo">
          <label for="responsavel_interno_id">Responsável interno</label>
          <select id="responsavel_interno_id" name="responsavel_interno_id">
            <option value="">—</option>
            <% responsaveis.forEach(function (u) { %>
              <option value="<%= u.id %>" <%= String(valores.responsavel_interno_id) === String(u.id) ? 'selected' : '' %>><%= u.nome %> (<%= u.setor %>)</option>
            <% }) %>
          </select>
        </div>
      </div>
    </fieldset>

    <%- include('../partials/seletor-cliente', { clientes: clientes, selecionado: valores.cliente_id }) %>

    <fieldset>
      <legend>Complemento</legend>
      <div class="campo">
        <label for="etapa_atual">Etapa atual</label>
        <input type="text" id="etapa_atual" name="etapa_atual" value="<%= valores.etapa_atual || '' %>" placeholder="Preenchida automaticamente conforme o checklist">
      </div>
      <div class="campo">
        <label for="observacoes">Observações</label>
        <textarea id="observacoes" name="observacoes"><%= valores.observacoes || '' %></textarea>
      </div>
    </fieldset>

    <div class="acoes">
      <button class="botao">Abrir processo</button>
      <a class="botao botao-secundario" href="/processos">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/rodape') %>
