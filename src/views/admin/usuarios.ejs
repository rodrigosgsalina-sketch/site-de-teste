<%- include('../partials/cabecalho', { titulo: titulo }) %>

<div class="cartao">
  <h3>Novo usuário</h3>
  <form method="post" action="/admin/usuarios">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="linha-campos">
      <div class="campo">
        <label for="nome">Nome <span class="obrig">*</span></label>
        <input type="text" id="nome" name="nome" required>
      </div>
      <div class="campo">
        <label for="login">ID de usuário</label>
        <input type="text" id="login" name="login" placeholder="deixe vazio para gerar do nome"
               autocapitalize="none" spellcheck="false">
        <div class="dica">É o que a pessoa digita para entrar. "Ana Paula" vira <span class="mono">ana.paula</span>.</div>
      </div>
      <div class="campo">
        <label for="email">E-mail (contato)</label>
        <input type="email" id="email" name="email">
      </div>
      <div class="campo">
        <label for="senha">Senha <span class="obrig">*</span></label>
        <input type="password" id="senha" name="senha" required minlength="6">
      </div>
      <div class="campo">
        <label for="setor_id">Setor <span class="obrig">*</span></label>
        <select id="setor_id" name="setor_id" required>
          <% setores.forEach(function (s) { %>
            <option value="<%= s.id %>"><%= s.nome %><%= s.auxiliar ? ' (auxiliar)' : '' %></option>
          <% }) %>
        </select>
      </div>
      <div class="campo">
        <label for="perfil">Perfil</label>
        <select id="perfil" name="perfil">
          <option value="Usuário">Usuário</option>
          <option value="Administrador">Administrador</option>
        </select>
      </div>
    </div>
    <button class="botao">Criar usuário</button>
  </form>
</div>

<div class="cartao">
  <h3><%= lista.length %> usuário(s)</h3>
  <p class="dica">
    O acesso é feito pelo <strong>ID de usuário</strong> — o e-mail é apenas contato.
    Perfil <strong>Administrador</strong> e setor <strong>Diretoria</strong> têm visão completa;
    os demais só enxergam os processos e itens do próprio setor.
  </p>
  <div class="tabela-scroll">
    <table class="tabela">
      <thead><tr><th>Nome</th><th>ID de usuário</th><th>E-mail</th><th>Setor</th><th>Perfil</th><th>Situação</th><th>Nova senha</th><th></th></tr></thead>
      <tbody>
        <% lista.forEach(function (u) { %>
          <tr>
            <td><input type="text" form="usuario-<%= u.id %>" name="nome" value="<%= u.nome %>" required></td>
            <td><input type="text" class="mono" form="usuario-<%= u.id %>" name="login" value="<%= u.login %>"
                       autocapitalize="none" spellcheck="false" required></td>
            <td><input type="email" form="usuario-<%= u.id %>" name="email" value="<%= u.email || '' %>"></td>
            <td>
              <select form="usuario-<%= u.id %>" name="setor_id">
                <% setores.forEach(function (s) { %>
                  <option value="<%= s.id %>" <%= s.id === u.setor_id ? 'selected' : '' %>><%= s.nome %></option>
                <% }) %>
              </select>
            </td>
            <td>
              <select form="usuario-<%= u.id %>" name="perfil">
                <option value="Usuário" <%= u.perfil === 'Usuário' ? 'selected' : '' %>>Usuário</option>
                <option value="Administrador" <%= u.perfil === 'Administrador' ? 'selected' : '' %>>Administrador</option>
              </select>
            </td>
            <td>
              <select form="usuario-<%= u.id %>" name="status">
                <option value="Ativo" <%= u.status === 'Ativo' ? 'selected' : '' %>>Ativo</option>
                <option value="Inativo" <%= u.status === 'Inativo' ? 'selected' : '' %>>Inativo</option>
              </select>
            </td>
            <td><input type="password" form="usuario-<%= u.id %>" name="senha" placeholder="(manter)" minlength="6" autocomplete="new-password"></td>
            <td><button class="botao botao-secundario botao-pequeno" form="usuario-<%= u.id %>">Salvar</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% lista.forEach(function (u) { %>
    <form id="usuario-<%= u.id %>" method="post" action="/admin/usuarios/<%= u.id %>" hidden>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
  <% }) %>
</div>

<%- include('../partials/rodape') %>
