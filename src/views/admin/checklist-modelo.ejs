<%- include('../partials/cabecalho', { titulo: titulo }) %>

<%
  var tipoAtual = tipoSelecionado ? tipos.find(function (t) { return t.id === tipoSelecionado; }) : null;
  var subtipoAtual = subtipoSelecionado
    ? subtiposDoTipo.find(function (s) { return s.id === subtipoSelecionado; })
    : null;
  /* Um item entra no checklist deste subtipo quando não é de subtipo nenhum
     (vale para o tipo inteiro ou para todo processo) ou é justamente dele. */
  var noSubtipo = function (m) {
    if (!subtipoAtual) return true;
    return !m.subtipo_processo_id || m.subtipo_processo_id === subtipoAtual.id;
  };
  var qs = function () {
    var base = { tipo: filtros.tipo, subtipo: filtros.subtipo, setor: filtros.setor, q: filtros.q,
                 obrigatorio: filtros.obrigatorio, ativo: filtros.ativo };
    return Object.keys(base)
      .filter(function (k) { return base[k] !== '' && base[k] !== undefined && base[k] !== null; })
      .map(function (k) { return k + '=' + encodeURIComponent(base[k]); })
      .join('&');
  };
%>

<!-- ------------------------------------------------------------- filtros -->
<div class="cartao">
  <form method="get" action="/admin/checklist-modelo">
    <div class="linha-campos">
      <div class="campo" style="grid-column: span 2">
        <label for="q">Buscar item</label>
        <input type="search" id="q" name="q" value="<%= filtros.q %>"
               placeholder="Trecho do item, setor ou tipo — ex.: certidão, DBE, débitos">
      </div>
      <div class="campo">
        <label for="tipo">Tipo de processo</label>
        <select id="tipo" name="tipo">
          <option value="">Todos os tipos</option>
          <option value="todos" <%= filtros.tipo === 'todos' ? 'selected' : '' %>>
            Somente itens aplicados a todo processo
          </option>
          <% tipos.forEach(function (t) { %>
            <option value="<%= t.id %>" <%= String(filtros.tipo) === String(t.id) ? 'selected' : '' %>>
              <%= t.nome %><%= tiposComOrdem.indexOf(t.id) !== -1 ? ' · ordem própria' : '' %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="campo">
        <label for="subtipo">Subtipo</label>
        <%# Depende do tipo: o servidor já manda as opções do tipo escolhido, e
            o JavaScript refaz a lista quando o tipo muda. %>
        <select id="subtipo" name="subtipo" data-subtipos-select-de="tipo"
                <%= tipoAtual && subtiposDoTipo.length ? '' : 'disabled' %>>
          <option value="">Todo o tipo</option>
          <% subtiposDoTipo.forEach(function (sub) { %>
            <option value="<%= sub.id %>" <%= subtipoSelecionado === sub.id ? 'selected' : '' %>>
              <%= sub.nome %><%= sub.ativo ? '' : ' (inativo)' %>
            </option>
          <% }) %>
        </select>
        <div class="dica">Mostra o checklist como ele fica num processo desse subtipo.</div>
      </div>
      <div class="campo">
        <label for="setor">Setor</label>
        <select id="setor" name="setor">
          <option value="">Todos os setores</option>
          <% setores.forEach(function (s) { %>
            <option value="<%= s.id %>" <%= String(filtros.setor) === String(s.id) ? 'selected' : '' %>>
              <%= s.nome %><%= s.auxiliar ? ' (auxiliar)' : '' %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="campo">
        <label for="obrigatorio">Obrigatoriedade</label>
        <select id="obrigatorio" name="obrigatorio">
          <option value="">Todas</option>
          <option value="1" <%= filtros.obrigatorio === '1' ? 'selected' : '' %>>Somente obrigatórios</option>
          <option value="0" <%= filtros.obrigatorio === '0' ? 'selected' : '' %>>Somente opcionais</option>
        </select>
      </div>
      <div class="campo">
        <label for="ativo">Situação</label>
        <select id="ativo" name="ativo">
          <option value="">Todas</option>
          <option value="1" <%= filtros.ativo === '1' ? 'selected' : '' %>>Somente ativos</option>
          <option value="0" <%= filtros.ativo === '0' ? 'selected' : '' %>>Somente inativos</option>
        </select>
      </div>
    </div>

    <div class="acoes">
      <button class="botao botao-pequeno">Aplicar filtros</button>
      <a class="botao botao-secundario botao-pequeno" href="/admin/checklist-modelo">Limpar</a>
      <span class="dica" style="margin-left:auto">
        <strong><%= itens.length %></strong> de <%= total %> item(ns) do modelo<% if (tipoAtual) { %>
          · tipo <strong><%= tipoAtual.nome %></strong><% if (subtipoAtual) { %>,
          subtipo <strong><%= subtipoAtual.nome %></strong><% } %>, com os itens de todo processo<% } %>
      </span>
    </div>
  </form>
</div>

<!-- ------------------------------------------------- ordem de atendimento -->
<% if (tipoAtual) { %>
  <div class="cartao" id="ordem">
    <div class="cartao-titulo">
      <div>
        <h3>Ordem de atendimento — <%= tipoAtual.nome %></h3>
        <p class="dica" style="margin:0;max-width:70ch">
          Define quem responde primeiro neste tipo de processo. Vale para o agrupamento do checklist,
          para a etapa atual, para o status “Em Análise …” e para o aviso de vez do setor — inclusive
          nos processos que já estão em andamento.
        </p>
      </div>
      <% if (tiposComOrdem.indexOf(tipoAtual.id) !== -1) { %>
        <form method="post" action="/admin/checklist-modelo/ordem/limpar"
              data-confirmar="Voltar este tipo à ordem geral dos setores?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="tipo_processo_id" value="<%= tipoAtual.id %>">
          <button class="botao botao-secundario botao-pequeno">Voltar ao padrão</button>
        </form>
      <% } else { %>
        <span class="etiqueta et-neutro">seguindo a ordem geral dos setores</span>
      <% } %>
    </div>

    <% if (!ordemSetores.length) { %>
      <p class="vazio">Este tipo ainda não tem itens de checklist cadastrados.</p>
    <% } else { %>
      <p class="dica" data-ordem-ajuda>
        <strong>Arraste</strong> os setores para mudar a ordem. Com o teclado, dê
        <kbd>Tab</kbd> até o setor e use <kbd>↑</kbd> <kbd>↓</kbd>.
      </p>

      <form method="post" action="/admin/checklist-modelo/ordem" data-ordem-arrastavel
            data-campo="setor_ids">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="tipo_processo_id" value="<%= tipoAtual.id %>">
        <input type="hidden" name="setor_ids" value="<%= ordemSetores.map(function (s) { return s.id; }).join(',') %>">

        <ol class="ordem-lista ordem-setores">
          <% ordemSetores.forEach(function (s, i) { %>
            <li tabindex="0" data-id="<%= s.id %>"
                aria-label="<%= s.nome %>, posição <%= i + 1 %> de <%= ordemSetores.length %>">
              <span class="ordem-pegador" aria-hidden="true" title="Arraste para reordenar">⠿</span>
              <span class="ordem-posicao"><%= i + 1 %></span>
              <span class="ordem-nome">
                <strong><%= s.nome %></strong>
                <% if (s.auxiliar) { %><span class="etiqueta et-opcional">auxiliar</span><% } %>
                <small><%= s.itens %> item(ns)</small>
              </span>
              <%# O setor participa do tipo porque tem itens nele. Tirá-lo é
                  tirar esses itens — e os de "todo processo" ficam, porque
                  valem para todos os tipos. %>
              <% if (itensDoTipoPorSetor[s.id]) { %>
                <button type="submit" class="ordem-excluir" title="Remover <%= s.nome %> deste tipo"
                        form="remover-setor-<%= s.id %>">×</button>
              <% } else { %>
                <span class="ordem-nota" title="Só há itens de todo processo neste setor: eles valem para todos os tipos e saem pela listagem abaixo.">só todo processo</span>
              <% } %>
            </li>
          <% }) %>
        </ol>

        <%# Sem JavaScript o botão continua salvando; com JavaScript ele some,
            porque o arrastar já grava sozinho. %>
        <div class="acoes" data-ordem-manual>
          <button class="botao botao-secundario botao-pequeno">Salvar ordem</button>
          <span class="dica">Sem arrastar? Use os campos acima e salve aqui.</span>
        </div>
        <span class="dica" data-ordem-estado role="status" aria-live="polite"></span>
      </form>

      <%# Um formulário por setor, fora da lista: formulário dentro de <ol>
          arrastável atrapalha o arrasto, e o botão só precisa apontar para ele. %>
      <% ordemSetores.forEach(function (s) { %>
        <% if (itensDoTipoPorSetor[s.id]) { %>
          <form id="remover-setor-<%= s.id %>" method="post" action="/admin/checklist-modelo/setor/remover" hidden
                data-confirmar="Remover o setor <%= s.nome %> deste tipo? Saem <%= itensDoTipoPorSetor[s.id] %> item(ns) do modelo. Processos já abertos não são afetados.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="tipo_processo_id" value="<%= tipoAtual.id %>">
            <input type="hidden" name="setor_id" value="<%= s.id %>">
            <input type="hidden" name="retorno" value="<%= qs() %>">
            <input type="hidden" name="ancora" value="ordem">
          </form>
        <% } %>
      <% }) %>
    <% } %>

    <%# Adicionar um setor é criar o primeiro item dele: sem item, o setor não
        teria o que fazer no checklist. %>
    <% if (setoresDeFora.length) { %>
      <details class="adicionar-bloco">
        <summary>Adicionar setor a este tipo</summary>
        <form method="post" action="/admin/checklist-modelo">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="tipo_processo_id" value="<%= tipoAtual.id %>">
          <input type="hidden" name="retorno" value="<%= qs() %>">
          <input type="hidden" name="ancora" value="ordem">
          <div class="linha-campos">
            <div class="campo">
              <label for="novo-setor">Setor <span class="obrig">*</span></label>
              <select id="novo-setor" name="setor_id" required>
                <% setoresDeFora.forEach(function (s) { %>
                  <option value="<%= s.id %>"><%= s.nome %><%= s.auxiliar ? ' (auxiliar)' : '' %></option>
                <% }) %>
              </select>
            </div>
            <div class="campo largo">
              <label for="novo-setor-item">Primeiro item deste setor <span class="obrig">*</span></label>
              <input type="text" id="novo-setor-item" name="item" required
                     placeholder="Ex.: Conferência final do processo?">
            </div>
            <div class="campo">
              <label for="novo-setor-subtipo">Subtipo</label>
              <select id="novo-setor-subtipo" name="subtipo_processo_id">
                <option value="">Todo o tipo</option>
                <% subtiposDoTipo.forEach(function (sub) { %>
                  <option value="<%= sub.id %>" <%= subtipoSelecionado === sub.id ? 'selected' : '' %>>
                    <%= sub.nome %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="campo checkbox" style="align-self:center">
              <input type="checkbox" id="novo-setor-obrig" name="obrigatorio" value="1" checked>
              <label for="novo-setor-obrig">Obrigatório</label>
            </div>
          </div>
          <button class="botao botao-secundario botao-pequeno">Adicionar setor</button>
        </form>
      </details>
    <% } %>
  </div>

  <!-- ----------------------------------------------------- ordem dos itens -->
  <% if (ordemItens.length) { %>
    <div class="cartao" id="ordem-itens">
      <div class="cartao-titulo">
        <div>
          <h3>
            Ordem dos itens — <%= tipoAtual.nome %><% if (subtipoAtual) { %> ·
            <%= subtipoAtual.nome %><% } %>
          </h3>
          <p class="dica" style="margin:0;max-width:74ch">
            Dentro de cada setor, a sequência em que os itens aparecem no checklist.
            <strong>Arraste</strong> para mudar (com o teclado, <kbd>Tab</kbd> e <kbd>↑</kbd> <kbd>↓</kbd>),
            <strong>×</strong> para excluir e o campo no fim do setor para adicionar.
            <% if (subtipoAtual) { %>
              Os itens apagados são de outro subtipo: eles não entram no checklist de
              <strong><%= subtipoAtual.nome %></strong>, mas dividem a mesma ordem do setor.
            <% } %>
            Vale para <strong>novos processos</strong>; nos que já estão abertos, use
            <em>Atualizar checklist</em> na tela do processo.
          </p>
        </div>
      </div>

      <% ordemItens.forEach(function (grupo) { %>
        <% var noChecklist = grupo.itens.filter(noSubtipo).length; %>
        <div class="grupo-itens">
          <h4>
            <%= grupo.setor %>
            <% if (grupo.auxiliar) { %><span class="etiqueta et-opcional">auxiliar</span><% } %>
            <small>
              <%= grupo.itens.length %> item(ns)<% if (subtipoAtual) { %>
              · <%= noChecklist %> no checklist deste subtipo<% } %>
            </small>
          </h4>

          <form method="post" action="/admin/checklist-modelo/ordem-itens" data-ordem-arrastavel
                data-campo="item_ids">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="tipo_processo_id" value="<%= tipoAtual.id %>">
            <input type="hidden" name="setor_id" value="<%= grupo.setor_id %>">
            <input type="hidden" name="item_ids"
                   value="<%= grupo.itens.map(function (i) { return i.id; }).join(',') %>">

            <ol class="ordem-lista ordem-itens">
              <% grupo.itens.forEach(function (m, i) { %>
                <%# Com um subtipo escolhido, o que é de OUTRO subtipo continua na
                    lista — a ordem é uma só para o setor inteiro —, mas aparece
                    apagado, para a leitura ser a do checklist daquele subtipo. %>
                <li tabindex="0" data-id="<%= m.id %>" class="<%= noSubtipo(m) ? '' : 'fora-do-subtipo' %>"
                    aria-label="<%= m.item %>, posição <%= i + 1 %> de <%= grupo.itens.length %>">
                  <span class="ordem-pegador" aria-hidden="true" title="Arraste para reordenar">⠿</span>
                  <span class="ordem-posicao"><%= i + 1 %></span>
                  <span class="ordem-nome">
                    <strong><%= m.item %></strong>
                    <% if (!m.tipo_processo_id) { %>
                      <span class="etiqueta et-neutro" title="Este item vale para todo processo: mover aqui move em todos os tipos.">todo processo</span>
                    <% } %>
                    <% if (m.subtipo) { %><span class="etiqueta et-neutro"><%= m.subtipo %></span><% } %>
                    <% if (!m.obrigatorio) { %><span class="etiqueta et-opcional">opcional</span><% } %>
                    <% if (!m.ativo) { %><span class="etiqueta et-neutro">inativo</span><% } %>
                  </span>
                  <button type="submit" class="ordem-excluir" title="Excluir este item do modelo"
                          form="excluir-item-<%= m.id %>">×</button>
                </li>
              <% }) %>
            </ol>

            <div class="acoes" data-ordem-manual>
              <button class="botao botao-secundario botao-pequeno">Salvar ordem dos itens</button>
            </div>
            <span class="dica" data-ordem-estado role="status" aria-live="polite"></span>
          </form>

          <% grupo.itens.forEach(function (m) { %>
            <form id="excluir-item-<%= m.id %>" method="post" hidden
                  action="/admin/checklist-modelo/<%= m.id %>/excluir"
                  data-confirmar="Excluir do modelo o item &quot;<%= m.item %>&quot;<%= m.tipo_processo_id ? '' : ' (ele vale para TODOS os tipos)' %>? Processos já abertos não são afetados.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="retorno" value="<%= qs() %>">
              <input type="hidden" name="ancora" value="ordem-itens">
            </form>
          <% }) %>

          <form method="post" action="/admin/checklist-modelo" class="adicionar-item">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="tipo_processo_id" value="<%= tipoAtual.id %>">
            <input type="hidden" name="setor_id" value="<%= grupo.setor_id %>">
            <input type="hidden" name="retorno" value="<%= qs() %>">
            <input type="hidden" name="ancora" value="ordem-itens">
            <input type="text" name="item" required
                   placeholder="Novo item para o <%= grupo.setor %>…"
                   aria-label="Novo item para o <%= grupo.setor %>">
            <% if (subtiposDoTipo.length) { %>
              <select name="subtipo_processo_id" aria-label="Subtipo do novo item">
                <option value="">Todo o tipo</option>
                <% subtiposDoTipo.forEach(function (sub) { %>
                  <option value="<%= sub.id %>" <%= subtipoSelecionado === sub.id ? 'selected' : '' %>>
                    <%= sub.nome %>
                  </option>
                <% }) %>
              </select>
            <% } %>
            <label class="campo checkbox">
              <input type="checkbox" name="obrigatorio" value="1" checked>
              <span>obrigatório</span>
            </label>
            <button class="botao botao-secundario botao-pequeno">Adicionar item</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
<% } else { %>
  <div class="cartao">
    <div class="aviso aviso-info" style="margin:0">
      Escolha um <strong>tipo de processo</strong> no filtro acima para definir a
      <strong>ordem de atendimento dos setores</strong> e a <strong>ordem dos itens</strong> dentro
      de cada um — por exemplo, colocar o Departamento Pessoal primeiro e o Paralegal por último.
    </div>
  </div>
<% } %>

<!-- ------------------------------------------------------------ novo item -->
<div class="cartao">
  <h3>Novo item</h3>
  <form method="post" action="/admin/checklist-modelo">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="retorno" value="<%= qs() %>">
    <div class="linha-campos">
      <div class="campo">
        <label for="tipo_processo_id">Tipo de processo</label>
        <select id="tipo_processo_id" name="tipo_processo_id">
          <option value="todos">Todos os processos</option>
          <% tipos.forEach(function (t) { %>
            <option value="<%= t.id %>" <%= tipoSelecionado === t.id ? 'selected' : '' %>><%= t.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="campo">
        <label for="subtipo_processo_id">Subtipo</label>
        <%# Já vem preenchido com o subtipo filtrado: quem está montando o
            checklist de um subtipo quer criar o item nele. %>
        <select id="subtipo_processo_id" name="subtipo_processo_id"
                data-subtipos-select-de="tipo_processo_id">
          <option value="">Todo o tipo</option>
          <% subtiposDoTipo.forEach(function (sub) { %>
            <option value="<%= sub.id %>" <%= subtipoSelecionado === sub.id ? 'selected' : '' %>>
              <%= sub.nome %><%= sub.ativo ? '' : ' (inativo)' %>
            </option>
          <% }) %>
        </select>
        <div class="dica">Deixe em “Todo o tipo” para o item valer em qualquer processo do tipo.</div>
      </div>
      <div class="campo">
        <label for="setor_id">Setor <span class="obrig">*</span></label>
        <select id="setor_id" name="setor_id" required>
          <% setores.forEach(function (s) { %>
            <option value="<%= s.id %>" <%= String(filtros.setor) === String(s.id) ? 'selected' : '' %>><%= s.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="campo" style="grid-column: span 2">
        <label for="item">Item <span class="obrig">*</span></label>
        <input type="text" id="item" name="item" placeholder="Ex.: Contrato Social elaborado?" required>
      </div>
      <div class="campo checkbox" style="align-self:center">
        <input type="checkbox" id="obrigatorio" name="obrigatorio" value="1" checked>
        <label for="obrigatorio">Obrigatório</label>
      </div>
    </div>
    <button class="botao">Adicionar item</button>
  </form>
</div>

<!-- ------------------------------------------------------------- listagem -->
<div class="cartao">
  <div class="cartao-titulo">
    <h3><%= itens.length %> item(ns) encontrados</h3>
    <% if (tipoAtual) { %>
      <span class="dica">Listados na ordem de atendimento definida acima.</span>
    <% } %>
  </div>

  <% if (!itens.length) { %>
    <p class="vazio">Nenhum item corresponde aos filtros. <a href="/admin/checklist-modelo">Limpar filtros</a>.</p>
  <% } else { %>
    <div class="tabela-scroll">
      <table class="tabela" id="tabela-modelo">
        <thead>
          <tr><th>Tipo</th><th>Subtipo</th><th>Setor</th><th>Item</th><th>Obrigatório</th><th>Ativo</th><th></th></tr>
        </thead>
        <tbody>
          <% itens.forEach(function (m) { %>
            <tr>
              <td>
                <select form="modelo-<%= m.id %>" name="tipo_processo_id">
                  <option value="todos" <%= m.tipo_processo_id ? '' : 'selected' %>>Todos</option>
                  <% tipos.forEach(function (t) { %>
                    <option value="<%= t.id %>" <%= m.tipo_processo_id === t.id ? 'selected' : '' %>><%= t.nome %></option>
                  <% }) %>
                </select>
              </td>
              <td>
                <select form="modelo-<%= m.id %>" name="subtipo_processo_id">
                  <option value="">Todo o tipo</option>
                  <% (subtiposPorTipoLista[String(m.tipo_processo_id)] || []).forEach(function (sub) { %>
                    <option value="<%= sub.id %>" <%= m.subtipo_processo_id === sub.id ? 'selected' : '' %>><%= sub.nome %></option>
                  <% }) %>
                </select>
              </td>
              <td>
                <select form="modelo-<%= m.id %>" name="setor_id">
                  <% setores.forEach(function (s) { %>
                    <option value="<%= s.id %>" <%= m.setor_id === s.id ? 'selected' : '' %>><%= s.nome %></option>
                  <% }) %>
                </select>
              </td>
              <td><input type="text" form="modelo-<%= m.id %>" name="item" value="<%= m.item %>" required></td>
              <td><input type="checkbox" form="modelo-<%= m.id %>" name="obrigatorio" value="1" <%= m.obrigatorio ? 'checked' : '' %>></td>
              <td><input type="checkbox" form="modelo-<%= m.id %>" name="ativo" value="1" <%= m.ativo ? 'checked' : '' %>></td>
              <td class="acoes">
                <button class="botao botao-secundario botao-pequeno" form="modelo-<%= m.id %>">Salvar</button>
                <button class="botao botao-perigo botao-pequeno" form="modelo-excluir-<%= m.id %>">Excluir</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% itens.forEach(function (m) { %>
      <form id="modelo-<%= m.id %>" method="post" action="/admin/checklist-modelo" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="id" value="<%= m.id %>">
        <input type="hidden" name="retorno" value="<%= qs() %>">
      </form>
      <form id="modelo-excluir-<%= m.id %>" method="post" action="/admin/checklist-modelo/<%= m.id %>/excluir"
            data-confirmar="Remover este item do modelo?" hidden>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="retorno" value="<%= qs() %>">
      </form>
    <% }) %>
  <% } %>

  <p class="dica" style="margin-top:1rem">
    Alterações no modelo valem para <strong>novos processos</strong>. Processos já abertos mantêm o
    checklist clonado na abertura — a ordem de atendimento dos setores é aplicada também a eles, e
    o resto entra pelo botão <strong>Atualizar checklist</strong> na tela do processo, que mostra o
    que vai mudar antes de confirmar.
  </p>
</div>

<%# Subtipos por tipo, para o campo acompanhar o tipo escolhido sem ir ao
    servidor a cada troca. %>
<script nonce="<%= nonce %>">
  window.__subtiposPorTipo = <%- jsonSeguro(subtiposPorTipoLista) %>;
</script>

<%- include('../partials/rodape') %>
