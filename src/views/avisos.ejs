<%- include('partials/cabecalho', { titulo: titulo }) %>

<div class="cartao">
  <div class="cartao-titulo">
    <div>
      <h2>Mural de avisos</h2>
      <p class="dica" style="margin:0">
        Cada movimento de processo gera um aviso: ele aparece na hora, como um cartão no canto
        inferior direito, e fica registrado aqui. Conclusão e impedimento valem para todo o
        escritório; abertura, cancelamento, reabertura, vez do setor e alerta de prazo vão para
        quem participa do processo. Dispensar um aviso afeta apenas a sua tela.
      </p>
    </div>
    <div class="acoes">
      <button type="button" class="botao botao-secundario botao-pequeno" data-permitir-notificacoes>
        Ativar avisos do navegador
      </button>
    <% if (avisosTotal) { %>
      <form method="post" action="/avisos/lidos">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="retorno" value="/avisos">
        <button class="botao botao-secundario botao-pequeno">Marcar todos como lidos</button>
      </form>
    <% } %>
    </div>
  </div>

  <div class="som-avisos">
    <label class="som-avisos-chave">
      <%# Marcada já no HTML: o som vem ligado por padrão, e assim a caixa diz a
          verdade mesmo no instante antes de o JavaScript acertar o que está
          gravado neste computador. %>
      <input type="checkbox" data-som-avisos checked>
      <span>
        <strong>Tocar um som quando chegar aviso</strong>
        <span class="dica">
          Serve para perceber o aviso com a plataforma em outra aba. O ajuste vale para este
          computador. Se a notificação do navegador estiver ativada, o som é o do próprio sistema —
          não toca duas vezes.
        </span>
        <span class="dica som-avisos-estado" data-som-estado></span>
      </span>
    </label>
    <button type="button" class="botao botao-secundario botao-pequeno" data-testar-som>Testar som</button>
  </div>

  <% if (!lista.length) { %>
    <p class="vazio">Nenhum aviso publicado até agora.</p>
  <% } else { %>
    <div class="tabela-scroll">
      <table class="tabela">
        <thead>
          <tr><th>Quando</th><th>Tipo</th><th>Aviso</th><th>Processo</th><th>Situação</th></tr>
        </thead>
        <tbody>
          <% lista.forEach(function (av) { %>
            <tr>
              <td><%= fmtDataHora(av.criado_em) %></td>
              <td>
                <span class="etiqueta et-<%= corAviso(av.tipo) %>"><%= rotuloAviso(av.tipo) %></span>
                <% if (av.escopo === 'todos') { %>
                  <div class="item-meta">todos os usuários</div>
                <% } else { %>
                  <div class="item-meta">setores do processo</div>
                <% } %>
              </td>
              <td>
                <strong><%= av.titulo %></strong>
                <div class="item-meta"><%= av.mensagem %></div>
                <div class="item-meta">Registrado por <%= av.usuario_nome || 'Sistema' %></div>
              </td>
              <td>
                <% if (av.processo_id) { %>
                  <a class="mono" href="/processos/<%= av.processo_id %>"><%= av.processo_codigo %></a>
                <% } else { %>—<% } %>
              </td>
              <td>
                <% if (av.lido_em) { %>
                  <span class="etiqueta et-neutro">lido</span>
                <% } else { %>
                  <form method="post" action="/avisos/<%= av.id %>/lido">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="retorno" value="/avisos">
                    <button class="botao botao-secundario botao-pequeno">Marcar como lido</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/rodape') %>
