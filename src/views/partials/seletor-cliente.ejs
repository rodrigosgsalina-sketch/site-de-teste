<%
/* Seletor de cliente usado na abertura e na edição do processo.
   Espera: clientes (lista) e selecionado (id atual, pode ser vazio). */
const idSelecionado = selecionado === undefined || selecionado === null ? '' : String(selecionado);
%>
<fieldset>
  <legend>Cliente</legend>

  <% if (!clientes.length) { %>
    <div class="aviso aviso-alerta">
      Nenhuma empresa cadastrada ainda. O processo é sempre aberto para um cliente do cadastro —
      <a href="/clientes">abra a aba Clientes</a> e cadastre (ou importe) as empresas antes de continuar.
    </div>
  <% } else { %>
    <div class="linha-campos">
      <div class="campo">
        <label for="busca_cliente">Buscar empresa</label>
        <input type="search" id="busca_cliente" data-filtra-lista="cliente_id" autocomplete="off"
               placeholder="Código, nome, CNPJ ou município">
        <div class="dica">Filtra a lista ao lado enquanto você digita. <%= clientes.length %> empresa(s) cadastrada(s).</div>
      </div>
      <div class="campo">
        <label for="cliente_id">Cliente <span class="obrig">*</span></label>
        <select id="cliente_id" name="cliente_id" required data-resumo-cliente="cliente-escolhido">
          <option value="">Selecione…</option>
          <% clientes.forEach(function (c) {
               const titulo = c.razao_social || c.nome;
               const apelido = c.apelido && c.apelido !== titulo ? ` (${c.apelido})` : '';
               const local = [c.municipio, c.uf].filter(Boolean).join('/');
               const situacao = c.situacao && c.situacao !== 'Ativa' ? ` · ${c.situacao}` : '';
          %>
            <option value="<%= c.id %>" <%= idSelecionado === String(c.id) ? 'selected' : '' %>
                    data-busca="<%= [c.codigo, c.apelido, c.nome, c.razao_social, c.nome_fantasia, c.municipio, c.uf, c.cnpj_cpf].filter(Boolean).join(' ') %>"
                    data-digitos="<%= String(c.cnpj_cpf || '').replace(/\D+/g, '') %>"
                    data-razao="<%= titulo %>"
                    data-cnpj="<%= c.cnpj_cpf || '—' %>"
                    data-local="<%= local || '—' %>"
                    data-responsavel="<%= c.responsavel_legal || '—' %>"
                    data-telefone="<%= c.telefone || '—' %>"
                    data-email="<%= c.email || '—' %>"
                    data-ficha="/clientes/<%= c.id %>"><%= c.codigo %> — <%= titulo %><%= apelido %><%= local ? ` · ${local}` : '' %><%= situacao %></option>
          <% }) %>
        </select>
        <div class="dica">Os dados da empresa vêm do cadastro — não precisam ser digitados aqui.</div>
      </div>
    </div>

    <div class="cliente-resumo" id="cliente-escolhido" hidden>
      <div class="grade grade-4">
        <div><label>Razão social</label><div data-campo="razao">—</div></div>
        <div><label>CNPJ / CPF</label><div class="mono" data-campo="cnpj">—</div></div>
        <div><label>Município / UF</label><div data-campo="local">—</div></div>
        <div><label>Responsável legal</label><div data-campo="responsavel">—</div></div>
        <div><label>Telefone</label><div data-campo="telefone">—</div></div>
        <div><label>E-mail</label><div data-campo="email">—</div></div>
      </div>
      <a class="botao botao-secundario botao-pequeno" data-campo="ficha" href="#" target="_blank" rel="noopener">Ver ficha completa</a>
    </div>
  <% } %>
</fieldset>
