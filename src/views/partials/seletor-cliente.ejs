<%
/* Seletor de cliente usado na abertura e na edição do processo.

   Espera: totalClientes (quantas empresas existem), clienteAtual (a empresa já
   escolhida, ou null) e selecionado (id atual, pode ser vazio).

   A lista NÃO vem pronta no HTML. Antes vinham as 945 empresas de uma vez, com
   nove atributos cada: 676 KB por carregamento da tela. Agora a busca consulta
   /clientes/buscar enquanto se digita e só as poucas empresas que casam viajam.
   O <select> continua existindo — é ele que o formulário envia, e é dele que
   vem a validação de campo obrigatório do próprio navegador. */
const idSelecionado = selecionado === undefined || selecionado === null ? '' : String(selecionado);
const atual = typeof clienteAtual !== 'undefined' ? clienteAtual : null;
const total = typeof totalClientes === 'number' ? totalClientes : 0;
%>
<fieldset>
  <legend>Cliente</legend>

  <% if (!total) { %>
    <div class="aviso aviso-alerta">
      Nenhuma empresa cadastrada ainda. O processo é sempre aberto para um cliente do cadastro —
      <a href="/clientes">abra a aba Clientes</a> e cadastre (ou importe) as empresas antes de continuar.
    </div>
  <% } else { %>
    <div class="linha-campos" data-seletor-cliente>
      <div class="campo">
        <label for="busca_cliente">Buscar empresa</label>
        <input type="search" id="busca_cliente" data-busca-cliente="cliente_id" autocomplete="off"
               placeholder="Código, nome, CNPJ ou município">
        <div class="dica" data-busca-situacao><%= total %> empresa(s) cadastrada(s). Digite para localizar.</div>
      </div>
      <div class="campo">
        <label for="cliente_id">Cliente <span class="obrig">*</span></label>
        <select id="cliente_id" name="cliente_id" required data-resumo-cliente="cliente-escolhido">
          <option value="">Selecione…</option>
          <% if (atual) {
               const titulo = atual.razao_social || atual.nome;
               const apelido = atual.apelido && atual.apelido !== titulo ? ` (${atual.apelido})` : '';
               const local = [atual.municipio, atual.uf].filter(Boolean).join('/');
               const situacao = atual.situacao && atual.situacao !== 'Ativa' ? ` · ${atual.situacao}` : '';
          %>
            <option value="<%= atual.id %>" selected
                    data-razao="<%= titulo %>"
                    data-cnpj="<%= atual.cnpj_cpf || '—' %>"
                    data-local="<%= local || '—' %>"
                    data-responsavel="<%= atual.responsavel_legal || '—' %>"
                    data-telefone="<%= atual.telefone || '—' %>"
                    data-email="<%= atual.email || '—' %>"
                    data-ficha="/clientes/<%= atual.id %>"><%= atual.codigo %> — <%= titulo %><%= apelido %><%= local ? ` · ${local}` : '' %><%= situacao %></option>
          <% } %>
        </select>
        <div class="dica">Os dados da empresa vêm do cadastro — não precisam ser digitados aqui.</div>
      </div>
    </div>

    <div class="cliente-resumo" id="cliente-escolhido" <%= atual ? '' : 'hidden' %>>
      <div class="grade grade-4">
        <div><label>Razão social</label><div data-campo="razao">—</div></div>
        <div><label>CNPJ / CPF</label><div class="mono" data-campo="cnpj">—</div></div>
        <div><label>Município / UF</label><div data-campo="local">—</div></div>
        <div><label>Responsável legal</label><div data-campo="responsavel">—</div></div>
        <div><label>Telefone</label><div data-campo="telefone">—</div></div>
        <div><label>E-mail</label><div data-campo="email">—</div></div>
      </div>
      <a class="botao botao-secundario botao-pequeno" data-campo="ficha" href="#" target="_blank" rel="noopener">Ver ficha completa</a>
    </div>

    <% if (idSelecionado && !atual) { %>
      <div class="aviso aviso-alerta">
        Este processo aponta para uma empresa que não está mais no cadastro. Escolha a empresa correta acima.
      </div>
    <% } %>
  <% } %>
</fieldset>
