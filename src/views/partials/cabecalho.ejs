<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · JS Grilo Processos</title>
  <%# O token vai também no cabeçalho para as ações feitas por JavaScript (dispensar aviso). %>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="preload" as="font" type="font/woff2" href="<%= estatico('/fonts/manrope-latin-wght-normal.woff2') %>" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="<%= estatico('/fonts/ibm-plex-sans-latin-wght-normal.woff2') %>" crossorigin>
  <link rel="stylesheet" href="<%= estatico('/css/app.css') %>">
  <%# Ícone da aba e da tela de início do celular: o monograma da marca sobre o
      ladrilho azul. Quando há aviso por ler, o public/js/notificacoes.js troca
      este ícone pelo número e depois devolve este mesmo endereço. %>
  <link rel="icon" href="<%= estatico('/img/icone-jsgrilo.png') %>" type="image/png">
  <link rel="apple-touch-icon" href="<%= estatico('/img/icone-jsgrilo.png') %>">
</head>
<body data-avisos-debug="<%= typeof debugAvisos !== 'undefined' && debugAvisos ? '1' : '' %>">
<% if (typeof usuario !== 'undefined' && usuario) { %>
<div class="app">
  <aside class="lateral" id="lateral">
    <%# A marca é o logotipo do escritório na versão para fundo escuro. Ela
        também é o caminho de volta para o começo, como se espera de um
        logotipo no topo. %>
    <a class="marca" href="/dashboard">
      <img class="marca-logo" src="<%= estatico('/img/logo-jsgrilo-claro.png') %>"
           alt="JS Grilo Contabilidade &amp; Gestão" width="900" height="297" decoding="async">
    </a>
    <nav>
      <a href="/dashboard" class="<%= caminhoAtual.startsWith('/dashboard') ? 'ativo' : '' %>">Dashboard</a>
      <a href="/" class="<%= caminhoAtual === '/' ? 'ativo' : '' %>">Minha fila</a>
      <a href="/processos" class="<%= caminhoAtual.startsWith('/processos') ? 'ativo' : '' %>">Processos</a>
      <a href="/clientes" class="<%= caminhoAtual.startsWith('/clientes') ? 'ativo' : '' %>">Clientes</a>
      <a href="/processos/novo" class="<%= caminhoAtual === '/processos/novo' ? 'ativo' : '' %>">Abrir processo</a>
      <a href="/checklist/fila" class="<%= caminhoAtual.startsWith('/checklist') ? 'ativo' : '' %>">Fila do setor</a>
      <a href="/avisos" class="<%= caminhoAtual.startsWith('/avisos') ? 'ativo' : '' %>">
        Avisos
        <span class="contador" data-contador-avisos <%= avisosTotal ? '' : 'hidden' %>><%= avisosTotal %></span>
      </a>
      <% if (ehAdmin) { %>
        <span class="nav-grupo">Administração</span>
        <a href="/admin/parametros" class="<%= caminhoAtual === '/admin/parametros' ? 'ativo' : '' %>">Parâmetros</a>
        <a href="/admin/checklist-modelo" class="<%= caminhoAtual === '/admin/checklist-modelo' ? 'ativo' : '' %>">Checklist modelo</a>
        <a href="/admin/usuarios" class="<%= caminhoAtual === '/admin/usuarios' ? 'ativo' : '' %>">Usuários</a>
        <a href="/admin/tabelas" class="<%= caminhoAtual === '/admin/tabelas' ? 'ativo' : '' %>">Tipos e setores</a>
        <a href="/admin/notificacoes" class="<%= caminhoAtual === '/admin/notificacoes' ? 'ativo' : '' %>">Notificações</a>
        <a href="/admin/auditoria" class="<%= caminhoAtual === '/admin/auditoria' ? 'ativo' : '' %>">Auditoria</a>
      <% } %>
    </nav>
    <div class="lateral-rodape">
      <a href="/perfil" class="usuario-chip">
        <strong><%= usuario.nome %></strong>
        <small><%= setoresDoUsuario.join(' · ') || usuario.setor %> · <%= usuario.perfil %></small>
      </a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-link">Sair</button></form>
    </div>
  </aside>

  <main class="conteudo">
    <header class="topo">
      <%# O clique é ligado no public/js/app.js: a política de segurança da
          página (CSP) não deixa rodar JavaScript escrito dentro do atributo. %>
      <button type="button" class="menu-toggle" data-menu-lateral aria-controls="lateral"
              aria-expanded="false" aria-label="Menu">☰</button>
      <%# No celular a lateral fica escondida atrás do botão de menu, e com ela
          o logotipo. Este símbolo mantém a marca à vista nessas telas; nas
          maiores ele não aparece, porque a lateral já o mostra por inteiro. %>
      <a class="topo-marca" href="/dashboard" aria-label="JS Grilo Contabilidade e Gestão — início">
        <img src="<%= estatico('/img/simbolo-jsgrilo.png') %>" alt="" width="240" height="282" decoding="async">
      </a>
      <h1><%= titulo %></h1>
    </header>

    <% if (flash) { %>
      <div class="aviso aviso-<%= flash.tipo %>"><%= flash.mensagem %></div>
    <% } %>

    <%# Comunicados do usuário: concluído/impedido valem para todos; os demais,
        para quem participa do processo. Em tempo real eles chegam como cartão
        no canto inferior direito (public/js/notificacoes.js). %>
    <% avisos.forEach(function (av) { %>
      <div class="comunicado comunicado-<%= corAviso(av.tipo) %>">
        <span class="comunicado-marca"><%= rotuloAviso(av.tipo) %></span>
        <div class="comunicado-texto">
          <strong>
            <% if (av.processo_id) { %>
              <a href="/processos/<%= av.processo_id %>"><%= av.titulo %></a>
            <% } else { %><%= av.titulo %><% } %>
          </strong>
          <div><%= av.mensagem %></div>
          <small><%= fmtDataHora(av.criado_em) %> · <%= av.usuario_nome || 'Sistema' %></small>
        </div>
        <form method="post" action="/avisos/<%= av.id %>/lido">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="retorno" value="<%= caminhoAtual %>">
          <button class="botao-fechar" aria-label="Dispensar aviso" title="Dispensar">&times;</button>
        </form>
      </div>
    <% }) %>
<% } %>
