<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · JS Grilo Processos</title>
  <link rel="preload" as="font" type="font/woff2" href="<%= estatico('/fonts/manrope-latin-wght-normal.woff2') %>" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="<%= estatico('/fonts/ibm-plex-sans-latin-wght-normal.woff2') %>" crossorigin>
  <link rel="stylesheet" href="<%= estatico('/css/app.css') %>">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%2312395b'/><text x='16' y='22' font-size='16' font-family='sans-serif' fill='white' text-anchor='middle'>JS</text></svg>">
</head>
<body>
<div class="login-tela">
  <div class="login-caixa">
    <h1>JS Grilo Contabilidade &amp; Gestão</h1>
    <p class="sub">Plataforma de acompanhamento de processos internos</p>

    <% if (erro) { %><div class="aviso aviso-erro"><%= erro %></div><% } %>

    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="campo">
        <label for="login">ID de usuário <span class="obrig">*</span></label>
        <input type="text" id="login" name="login" value="<%= login %>" required autofocus
               autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="ex.: ana.paula">
      </div>
      <div class="campo">
        <label for="senha">Senha <span class="obrig">*</span></label>
        <input type="password" id="senha" name="senha" required autocomplete="current-password">
      </div>
      <button class="botao" style="width:100%">Entrar</button>
    </form>

    <p class="creditos-login">
      Plataforma criada por <strong>Rodrigo Grilo Salina</strong> e <strong>Gabriela Dionizio</strong>
    </p>
  </div>
</div>
</body>
</html>
