<%- include('partials/cabecalho') %>

<%
  // Medidas que a tela precisa saber para ampliar o arquivo até ficar legível.
  const dadosVisualizador = item
    ? {
        id: item.id,
        formato: item.formato,
        url: `/tabela-preco/arquivo/${item.id}`,
        largura: item.largura || null,
        altura: item.altura || null,
      }
    : null;
%>

<div class="cartao">
  <div class="cartao-titulo">
    <h2 style="margin:0">Tabelas de preço</h2>
    <span class="etiqueta et-neutro"><%= publicadas.length %> publicada(s)</span>
  </div>
  <p class="dica" style="margin:.2rem 0 0">
    Escolha abaixo qual tabela abrir. Elas valem para todo o escritório.
    <% if (podeEditar) { %>
      Você pode publicar, trocar e retirar tabelas na área no fim da página.
    <% } else { %>
      Quem publica e altera é o setor <%= setorResponsavel %> e os administradores.
    <% } %>
  </p>

  <% if (publicadas.length) { %>
    <%# Seletor: um link por tabela publicada. É link, e não um botão que troca
        a tela por JavaScript, de propósito — dá para guardar nos favoritos ou
        mandar a tabela certa para alguém. %>
    <nav class="tp-seletor" aria-label="Tabelas de preço publicadas">
      <% publicadas.forEach(function (t) { %>
        <a href="/tabela-preco?id=<%= t.id %>"
           class="tp-opcao <%= item && item.id === t.id ? 'ativa' : '' %>"
           <% if (item && item.id === t.id) { %>aria-current="page"<% } %>><%= t.titulo %></a>
      <% }) %>
    </nav>
  <% } %>
</div>

<% if (pedidaIndisponivel) { %>
  <div class="aviso aviso-alerta">
    A tabela deste endereço não está mais publicada<%= item ? ' — abrindo a primeira da lista.' : '.' %>
  </div>
<% } %>

<% if (item) { %>
  <div class="tp-sobre">
    <h3 style="margin:0"><%= item.titulo %></h3>
    <% if (!item.publicada) { %>
      <span class="etiqueta et-amarelo" title="Só quem administra vê esta tabela">fora de publicação</span>
    <% } %>
    <span class="dica">
      <%= item.nome_original %> · enviada em <%= fmtDataHora(item.criado_em) %>
      <% if (item.usuario_nome) { %> por <%= item.usuario_nome %><% } %>
    </span>
    <% if (item.descricao) { %><p style="margin:.3rem 0 0;width:100%"><%= item.descricao %></p><% } %>
  </div>
<% } %>

<% if (!item) { %>
  <div class="cartao">
    <p class="vazio">
      Nenhuma tabela de preço publicada.
      <% if (!podeEditar) { %>
        Assim que o setor <%= setorResponsavel %> publicar uma, ela aparece aqui.
      <% } else { %>
        Publique a primeira no formulário abaixo.
      <% } %>
    </p>
  </div>
<% } else if (semArquivo) { %>
  <div class="cartao">
    <div class="aviso aviso-alerta" style="margin:0">
      <strong>O arquivo desta tabela não está neste servidor.</strong>
      A tabela está cadastrada, mas o arquivo dela (<span class="mono"><%= item.nome_original %></span>)
      não veio junto — isso acontece ao restaurar um backup gerado antes de os arquivos da tabela de
      preço irem no backup.
      <% if (podeEditar) { %>
        Para corrigir, envie o arquivo de novo no formulário abaixo, escolhendo
        <strong>“<%= item.titulo %>”</strong> em <em>Substitui a tabela</em>.
      <% } else { %>
        Avise o setor <%= setorResponsavel %> para enviar o arquivo de novo.
      <% } %>
    </div>
  </div>
<% } else if (erroPlanilha) { %>
  <div class="aviso aviso-erro"><%= erroPlanilha %></div>
<% } else { %>

  <!-- ------------------------------------------------------ visualizador -->
  <div class="cartao tp-cartao">
    <div class="tp-barra" data-tp-barra hidden>
      <div class="tp-zoom">
        <button type="button" class="botao botao-secundario tp-botao" data-tp-menos aria-label="Diminuir">−</button>
        <input type="range" data-tp-faixa min="25" max="400" step="5" value="100"
               aria-label="Escala da tabela de preço">
        <button type="button" class="botao botao-secundario tp-botao" data-tp-mais aria-label="Aumentar">+</button>
        <output class="tp-escala" data-tp-valor>100%</output>
      </div>
      <div class="tp-acoes">
        <button type="button" class="botao botao-secundario" data-tp-ajustar>Ajustar à largura</button>
        <button type="button" class="botao botao-secundario" data-tp-natural>Tamanho real</button>
        <a class="botao botao-secundario" href="/tabela-preco/arquivo/<%= item.id %>?baixar=1">Baixar arquivo</a>
      </div>
    </div>

    <div class="tp-palco" data-tp-palco>
      <% if (item.formato === 'imagem') { %>
        <img class="tp-imagem" data-tp-imagem src="/tabela-preco/arquivo/<%= item.id %>"
             alt="Tabela de preço — <%= item.nome_original %>"
             <% if (item.largura) { %>width="<%= item.largura %>" height="<%= item.altura %>"<% } %>>

      <% } else if (item.formato === 'pdf') { %>
        <div class="tp-paginas" data-tp-paginas>
          <p class="vazio" data-tp-carregando>Abrindo o PDF…</p>
        </div>

      <% } else { %>
        <div class="tp-planilha" data-tp-planilha>
          <table class="tabela tp-grade">
            <% planilha.linhas.forEach(function (linha, i) { %>
              <tr>
                <% linha.forEach(function (celula) { %>
                  <% if (i === 0) { %><th><%= celula %></th><% } else { %><td><%= celula %></td><% } %>
                <% }) %>
              </tr>
            <% }) %>
          </table>
        </div>
      <% } %>
    </div>

    <p class="dica tp-rodape">
      <% if (item.formato === 'planilha') { %>
        Planilha <%= planilha.aba ? `“${planilha.aba}”` : '' %> — <%= planilha.linhas.length %> linha(s).
        <% if (planilha.truncada) { %>
          Exibindo as primeiras <%= planilha.linhas.length %> de <%= planilha.totalLinhas %>;
          baixe o arquivo para ver o restante.
        <% } %>
        <% if (planilha.abas && planilha.abas.length > 1) { %>
          A planilha tem <%= planilha.abas.length %> abas e a tela mostra a primeira.
        <% } %>
        Cores e formatação da planilha não vêm no arquivo lido — o conteúdo, sim.
      <% } else if (item.formato === 'pdf') { %>
        PDF desenhado nesta página: aumentar a escala redesenha o arquivo, então ele continua nítido
        em qualquer tamanho.
      <% } else if (item.largura && item.largura < larguraConfortavel) { %>
        A imagem enviada tem <%= item.largura %> px de largura e é ampliada para caber na tela.
        Ampliar não cria detalhe: se houver uma versão maior, vale trocar.
      <% } %>
    </p>
  </div>
<% } %>

<!-- ------------------------------------------------------------ alteração -->
<% if (podeEditar) { %>
  <div class="grade grade-2" id="administrar">
    <div class="cartao">
      <h3>Publicar uma tabela</h3>
      <p class="dica" style="margin:0 0 .8rem">
        Aceita <strong>.png</strong>, <strong>.pdf</strong> e <strong>.xlsx</strong>, até
        <%= tamanhoMaximoMb %> MB. Para leitura na tela, o PDF é o que fica mais nítido em qualquer
        zoom; sendo imagem, envie com pelo menos <%= larguraConfortavel %> px de largura.
      </p>
      <form method="post" action="/tabela-preco" enctype="multipart/form-data" data-tp-envio>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="campo">
          <label for="arquivo">Arquivo <span class="obrig">*</span></label>
          <input type="file" id="arquivo" name="arquivo" accept=".png,.pdf,.xlsx" required>
        </div>
        <div class="campo">
          <label for="substitui_id">Substitui a tabela</label>
          <select id="substitui_id" name="substitui_id" data-tp-substitui>
            <option value="">— nenhuma: é uma tabela nova —</option>
            <% publicadas.forEach(function (t) { %>
              <option value="<%= t.id %>" data-titulo="<%= t.titulo %>"><%= t.titulo %></option>
            <% }) %>
          </select>
          <div class="dica">
            Para atualizar o preço de uma tabela que já existe. O arquivo novo entra publicado com o
            mesmo título, e o anterior sai de publicação e fica guardado na lista ao lado.
          </div>
        </div>
        <div class="campo">
          <label for="titulo">Título</label>
          <input type="text" id="titulo" name="titulo" maxlength="120" data-tp-titulo
                 placeholder="ex.: Abertura de empresa — se ficar em branco, usa o nome do arquivo">
        </div>
        <div class="campo">
          <label for="descricao">Descrição</label>
          <input type="text" id="descricao" name="descricao" maxlength="200"
                 placeholder="ex.: vigência a partir de janeiro">
        </div>
        <button class="botao">Publicar tabela</button>
      </form>
    </div>

    <div class="cartao">
      <h3>Todas as tabelas</h3>
      <% if (!todas.length) { %>
        <p class="vazio">Nenhuma tabela enviada ainda.</p>
      <% } else { %>
        <p class="dica" style="margin:0 0 .8rem">
          As publicadas aparecem no seletor para todo o escritório. Retirar de publicação esconde
          a tabela sem apagar — dá para publicar de novo depois.
        </p>
        <ul class="tp-versoes">
          <% todas.forEach(function (v) { %>
            <li class="<%= v.publicada ? '' : 'tp-retirada' %>">
              <div class="tp-versao-info">
                <a href="/tabela-preco?id=<%= v.id %>"><strong><%= v.titulo %></strong></a>
                <% if (v.semArquivo) { %>
                  <span class="etiqueta et-vermelho" title="Envie de novo em Substitui a tabela">arquivo ausente</span>
                <% } %>
                <% if (v.publicada) { %>
                  <span class="etiqueta et-verde">publicada</span>
                <% } else { %>
                  <span class="etiqueta et-neutro">fora de publicação</span>
                <% } %>
                <small>
                  <%= v.nome_original %> · <%= fmtDataHora(v.criado_em) %><% if (v.usuario_nome) { %> · <%= v.usuario_nome %><% } %>
                  · <%= Math.max(1, Math.round((v.tamanho || 0) / 1024)) %> KB
                  <% if (v.descricao) { %> · <%= v.descricao %><% } %>
                </small>
                <details class="tp-renomear">
                  <summary>Renomear</summary>
                  <form method="post" action="/tabela-preco/<%= v.id %>/editar">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="campo">
                      <label for="titulo-<%= v.id %>">Título</label>
                      <input type="text" id="titulo-<%= v.id %>" name="titulo" value="<%= v.titulo %>" maxlength="120" required>
                    </div>
                    <div class="campo">
                      <label for="descricao-<%= v.id %>">Descrição</label>
                      <input type="text" id="descricao-<%= v.id %>" name="descricao" value="<%= v.descricao || '' %>" maxlength="200">
                    </div>
                    <button class="botao botao-secundario botao-pequeno">Salvar</button>
                  </form>
                </details>
              </div>
              <div class="tp-versao-acoes">
                <% if (v.publicada) { %>
                  <form method="post" action="/tabela-preco/<%= v.id %>/retirar">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="botao botao-secundario botao-pequeno">Retirar</button>
                  </form>
                <% } else { %>
                  <form method="post" action="/tabela-preco/<%= v.id %>/publicar">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="botao botao-secundario botao-pequeno">Publicar</button>
                  </form>
                <% } %>
                <form method="post" action="/tabela-preco/<%= v.id %>/remover"
                      data-confirmar="Apagar &quot;<%= v.titulo %>&quot; (<%= v.nome_original %>)? O arquivo some do servidor.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="botao botao-perigo botao-pequeno">Apagar</button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
<% } %>

<% if (item || podeEditar) { %>
  <script nonce="<%= nonce %>">
    window.TABELA_PRECO = <%- jsonSeguro(semArquivo ? null : dadosVisualizador) %>;
    window.TABELA_PRECO_PDFJS = {
      biblioteca: '<%= estatico('/vendor/pdf.min.mjs') %>',
      worker: '<%= estatico('/vendor/pdf.worker.min.mjs') %>'
    };
  </script>
  <script type="module" src="<%= estatico('/js/tabela-preco.js') %>" nonce="<%= nonce %>"></script>
<% } %>

<%- include('partials/rodape') %>
