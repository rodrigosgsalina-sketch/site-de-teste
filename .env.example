# ---------------------------------------------------------------- básico ---

# Porta em que a aplicação responde
PORT=3000

# Ambiente: development | production | test
# Em production a aplicação recusa subir com SESSION_SECRET padrão e sem HTTPS.
NODE_ENV=development

# Segredo dos cookies de sessão — OBRIGATÓRIO trocar em produção.
# Gere um valor com:  openssl rand -hex 32
SESSION_SECRET=troque-este-valor

# Diretório de dados (banco SQLite, uploads, backups)
DATA_DIR=./data

# Tamanho máximo de upload, em MB
UPLOAD_MAX_MB=15

# ---------------------------------------------------------------- HTTPS ----

# Opção A — a própria aplicação serve HTTPS.
# Aponte para o certificado e a chave em PEM (Let's Encrypt/certbot, ou o
# certificado de teste criado por "npm run certificado").
# TLS_CERT=/etc/letsencrypt/live/seu-dominio/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/seu-dominio/privkey.pem
# TLS_CA=
# TLS_PASSPHRASE=
# Porta HTTP que só redireciona para HTTPS (80 no servidor; 0 desliga)
# HTTP_REDIRECT_PORT=80

# Opção B — o HTTPS termina em um proxy à frente (nginx, Caddy, Cloudflare).
# Declare o proxy para a aplicação reconhecer o X-Forwarded-Proto e o IP real.
# TRUST_PROXY=1

# Recusa/redireciona requisições em HTTP puro (padrão: ligado em produção)
# FORCE_HTTPS=1

# Strict-Transport-Security, em segundos (0 desliga). 180 dias por padrão.
# HSTS_MAX_AGE=15552000

# ------------------------------------------------------------- segurança ---

# Custo do bcrypt nas senhas (12 é o recomendado; acima disso o login fica lento)
# BCRYPT_ROUNDS=12
# Tamanho mínimo da senha dos usuários
# SENHA_MINIMA=8
# Freio de força bruta no login: tentativas por janela e duração da janela
# LOGIN_TENTATIVAS=8
# LOGIN_JANELA_MINUTOS=15
# Duração da sessão, em horas
# SESSAO_HORAS=12

# ---------------------------------------------------------------- e-mail ---

# Transporte de e-mail: mock (registra no banco/console) ou smtp
MAIL_TRANSPORT=mock
MAIL_FROM=plataforma@jsgrilo.com.br

# Intervalo (minutos) da varredura automática de prazos. 0 desliga.
ALERT_INTERVAL_MINUTES=60

# Senha atribuída aos usuários criados pela carga inicial
SENHA_PADRAO=jsgrilo@2026
