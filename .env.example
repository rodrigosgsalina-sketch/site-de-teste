# ---------------------------------------------------------------- básico ---

# Porta em que a aplicação responde
PORT=3000

# Ambiente: development | production | test
# Em production a aplicação recusa subir com SESSION_SECRET padrão e sem HTTPS.
NODE_ENV=development

# Segredo dos cookies de sessão — OBRIGATÓRIO trocar em produção.
# Gere um valor com:  openssl rand -hex 32
SESSION_SECRET=troque-este-valor

# Diretório de dados (banco SQLite, uploads, backups)
DATA_DIR=./data

# Tamanho máximo de upload, em MB
UPLOAD_MAX_MB=15

# ---------------------------------------------------------------- HTTPS ----
# Três cenários. Escolha UM.

# --- Cenário 1: rede interna do escritório, sem domínio público -------------
# A própria aplicação serve HTTPS com um certificado emitido pela AUTORIDADE
# LOCAL criada por "npm run certificado". Instale data/certificados/autoridade.pem
# nos aparelhos (o passo a passo sai em COMO-INSTALAR.txt) e o aviso de
# "site não seguro" desaparece nesses aparelhos.
# NODE_ENV=production
# SESSION_SECRET=<openssl rand -hex 32>
# TLS_CERT=./data/certificados/certificado.pem
# TLS_KEY=./data/certificados/chave.pem
# PORT=443                  # no Linux, portas < 1024 exigem privilégio
# HTTP_REDIRECT_PORT=80     # a porta 80 só redireciona para https

# --- Cenário 2: domínio público, com proxy na frente (recomendado) ----------
# O Caddy (ou nginx/Cloudflare) termina o TLS e renova o certificado do
# Let's Encrypt sozinho; a aplicação continua em HTTP no localhost:3000.
# NODE_ENV=production
# SESSION_SECRET=<openssl rand -hex 32>
# TRUST_PROXY=1             # reconhece X-Forwarded-Proto e o IP real
# PORT=3000

# --- Cenário 3: domínio público, a própria aplicação servindo o TLS ---------
# Certificado do Let's Encrypt gerado pelo certbot.
# NODE_ENV=production
# SESSION_SECRET=<openssl rand -hex 32>
# TLS_CERT=/etc/letsencrypt/live/processos.seudominio.com.br/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/processos.seudominio.com.br/privkey.pem
# PORT=443
# HTTP_REDIRECT_PORT=80
# Pasta onde o certbot --webroot deixa o desafio de renovação. A porta 80
# entrega /.well-known/acme-challenge/ a partir daqui, sem parar a plataforma.
# ACME_WEBROOT=./data/acme

# Outros ajustes de TLS
# TLS_CA=
# TLS_PASSPHRASE=

# Recusa/redireciona requisições em HTTP puro (padrão: ligado em produção)
# FORCE_HTTPS=1

# Strict-Transport-Security, em segundos (0 desliga). 180 dias por padrão.
# Atenção: depois que um navegador recebe este cabeçalho, ele passa a exigir
# HTTPS naquele endereço pelo tempo indicado. Voltar para HTTP exigiria limpar
# o HSTS em cada aparelho. Na primeira semana de uso, um valor curto
# (ex.: 86400 = 1 dia) deixa a volta atrás mais fácil.
# HSTS_MAX_AGE=15552000

# ------------------------------------------------------------- segurança ---

# Custo do bcrypt nas senhas (12 é o recomendado; acima disso o login fica lento)
# BCRYPT_ROUNDS=12
# Tamanho mínimo da senha dos usuários
# SENHA_MINIMA=8
# Freio de força bruta no login: tentativas por janela e duração da janela
# LOGIN_TENTATIVAS=8
# LOGIN_JANELA_MINUTOS=15
# Duração da sessão, em horas
# SESSAO_HORAS=12

# --------------------------------------------------------- notificações ----

# Linhas de diagnóstico dos avisos no console (servidor e navegador).
# Ligado fora de produção. Em produção, o log não deve conter nome de cliente.
# LOG_NOTIFICACOES=1

# Web Push: notificação com o navegador FECHADO. Opcional e desligado sem as
# chaves — sem elas a plataforma não fala com nenhum serviço externo, e os
# avisos continuam aparecendo com a plataforma aberta em alguma aba.
# Gere o par com:  npm run vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@jsgrilo.com.br

# ---------------------------------------------------------------- e-mail ---

# Transporte de e-mail: mock (registra no banco/console) ou smtp
MAIL_TRANSPORT=mock
MAIL_FROM=plataforma@jsgrilo.com.br

# Intervalo (minutos) da varredura automática de prazos. 0 desliga.
ALERT_INTERVAL_MINUTES=60

# Senha atribuída aos usuários criados pela carga inicial
SENHA_PADRAO=jsgrilo@2026
